PORT=5000
MONGODB_URI=mongodb://localhost:27017/procurement_system
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=24h
COOKIE_EXPIRE=24

# Frontend origin for password-reset email links (Vercel URL in production)
CLIENT_URL=http://localhost:5173

# Comma-separated browser origins allowed to call the API (add your Vercel URL)
# Example: https://build-flow.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Set to false when frontend is deployed separately (e.g. Vercel)
SERVE_SPA=true

# Nodemailer configuration (real SMTP for production inbox delivery)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@procurement.com

NODE_ENV=development

# WaafiPay (real mobile wallet payments) — never commit real keys
WAAFI_API_URL=https://api.waafipay.net/asm
# Sandbox: https://sandbox.waafipay.com/asm
WAAFI_MERCHANT_UID=your_merchant_uid
WAAFI_API_USER_ID=your_api_user_id
WAAFI_API_KEY=your_api_key
WAAFI_CURRENCY=USD

# Days after PO create before Unpaid/Partially Paid becomes Overdue
PAYMENT_DUE_DAYS=30
